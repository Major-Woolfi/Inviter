# --- TELEGRAM ---
BOT_TOKEN=...
API_ID=...
API_HASH=...
OWNER_USER_IDS=...

# --- ЯЗЫКИ ---
DEFAULT_LANGUAGE=ru
LANGS_DIR=langs

# --- ПУТИ ---
SESSIONS_DIR=sessions
TASKS_DB_PATH=data/tasks.db
CHATS_DB_PATH=data/chats.db
CACHE_DB_PATH=data/cache.db
USERS_DB_PATH=data/users.db

# --- ПЛАНИРОВЩИК ЗАДАЧ ---
MAX_CONCURRENT_TASKS=10
MAX_TASKS_PER_USER=5
TASK_TIMEOUT=7200
TASK_HISTORY_DAYS=7
MIN_WORKERS=2
MAX_WORKERS=10
WORKER_CHECK_INTERVAL=10
WORKER_IDLE_TIMEOUT=300

# --- ИНВАЙТЫ ---
MIN_INVITE_DELAY=40
MAX_INVITE_DELAY=70
HUMAN_DELAY_EVERY=5
HUMAN_BREAK_CHANCE=0.2
HUMAN_BREAK_MIN=300
HUMAN_BREAK_MAX=900
SIMULATE_SKIP_RATE=0.05
HUMAN_SKIP_DELAY_MIN=10
HUMAN_SKIP_DELAY_MAX=30
INVITE_BUFFER_SIZE=10
INVITE_JITTER_MIN=0.8
INVITE_JITTER_MAX=1.2
POST_BUFFER_DELAY_MIN=30
POST_BUFFER_DELAY_MAX=60
MAX_INVITES_PER_ACCOUNT=500

# --- АККАУНТЫ ---
ADAPTIVE_DELAY_BASE=5.0
ADAPTIVE_DELAY_MAX=120.0
MAX_ACCOUNT_CONSECUTIVE_ERRORS=5
ACCOUNT_ERROR_COOLDOWN=300
ACCOUNT_HEALTH_CHECK_INTERVAL=300
ACCOUNT_CONNECT_TIMEOUT=30

# --- РОЛЛЕР АККАУНТОВ ---
ACCOUNT_ROLLER_WAIT_TIMEOUT=15
INVITE_STEP_USERS=1
MAILING_STEP_MESSAGES=1

# --- FLOODWAIT И RETRY ---
FLOOD_WAIT_MULTIPLIER=1.5
FLOOD_WAIT_PADDING=5
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RETRY_DEFAULT_DELAY=1.0
ERROR_BACKOFF_MIN=5.0
ERROR_BACKOFF_MAX=15.0

# --- КЭШ ---
ENTITY_CACHE_TTL=300
FULL_CHAT_CACHE_TTL=600
PARTICIPANTS_CACHE_TTL=600
INVITED_CACHE_TTL=3600

# --- ПРОВЕРКА ЧАТОВ ---
VALIDATOR_TEST_DELETE_WAIT=5
MAX_CHATS_PER_IMPORT=50
VALIDATOR_ANTI_FLOOD_DELAY_MIN=3
VALIDATOR_ANTI_FLOOD_DELAY_MAX=7
CHAT_ADD_THROTTLE_DELAY_MIN=1.0
CHAT_ADD_THROTTLE_DELAY_MAX=2.0

# --- СБОР ПОЛЬЗОВАТЕЛЕЙ ---
SCRAPE_MIN_MESSAGE_LIMIT=50
SCRAPE_MAX_MESSAGE_LIMIT=5000
SCRAPE_MIN_USER_COUNT=10
SCRAPE_MAX_USER_COUNT=1000

# --- РАССЫЛКА ---
MAILING_MIN_DELAY=45
MAILING_MAX_DELAY=80
MAILING_CHECK_INTERVAL=10
MAILING_FLOOD_WAIT_PADDING=5
MAILING_MAX_CONSECUTIVE_ERRORS=10
MAILING_CONSECUTIVE_ERROR_LONG_DELAY=30
MAILING_CONSECUTIVE_ERROR_SHORT_DELAY=2
MAILING_MAX_TOTAL_SENDS=5000

# --- РЕЖИМ ЧЕРВЯ ---
WORM_SCAN_LIMIT=0
WORM_MIN_DELAY=3
WORM_MAX_DELAY=7
WORM_MAX_SOURCES=10
WORM_CHECK_INTERVAL=10
WORM_SEEN_LIMIT=20000

# --- ФОН (обслуживание) ---
TASK_HEALTH_CHECK_INTERVAL=60
OLD_TASK_CLEANUP_INTERVAL=86400
ENTITY_CACHE_CLEANUP_INTERVAL=1800

# --- ФУНКЦИИ ---
AUTO_LEAVE_AFTER_INVITE=true
FEATURE_MAILING=true
FEATURE_MAILING_TO_USERS=true
FEATURE_WORM_MODE=true
