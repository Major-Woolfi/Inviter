# --- TELEGRAM BOT ---
BOT_TOKEN=...
API_ID=...
API_HASH=...
ADMIN_USER_IDS=...

# --- RATE LIMITING ---
RATE_LIMIT_COOLDOWN=0.2

# --- Task settings ---
MAX_CONCURRENT_TASKS=10
MAX_TASKS_PER_USER=5
MIN_WORKERS=2
MAX_WORKERS=10
WORKER_CHECK_INTERVAL=10
WORKER_IDLE_TIMEOUT=300

# --- ANTI-BLOCK SETTINGS ---
MIN_INVITE_DELAY=40
MAX_INVITE_DELAY=70
FLOOD_WAIT_MULTIPLIER=1.5
MAX_RETRIES=3
HEALTH_CHECK_INTERVAL=300
MAX_ACCOUNTS_PER_TASK=3
SESSION_TIMEOUT=1800

# --- HUMAN-LIKE BEHAVIOR ---
HUMAN_BREAK_CHANCE=0.2  # 20% шанс "перерыва на кофе"
HUMAN_BREAK_MIN=300  # Минимальный перерыв (сек)
HUMAN_BREAK_MAX=900  # Максимальный перерыв (сек)
SIMULATE_SKIP_RATE=0.05  # 5% шанс "ошибки" при инвите
ACTIVITY_SIMULATION_INTERVAL=3600  # Частота эмуляции активности (сек)

# --- WORM SETTINGS ---
WORM_BATCH_SIZE=50  # Размер пачки сообщений для обработки
WORM_CHECK_INTERVAL=10  # Проверка статуса каждые N сообщений
WORM_MIN_DELAY=3  # Минимальная задержка между чатами (сек)
WORM_MAX_DELAY=7  # Максимальная задержка между чатами (сек)
WORM_MESSAGE_LIMIT=0  # 0 = бесконечно, >0 = лимит сообщений
WORM_MAX_CONCURRENT=5  # Максимум одновременных червей
WORM_SCAN_LIMIT=1000  # Лимит сообщений на чат при сканировании

# --- VALIDATOR SETTINGS ---
VALIDATOR_TEST_DELETE_WAIT=5  # Время ожидания удаления тестового сообщения (сек)
VALIDATOR_RECONNECT_TIMEOUT=30  # Таймаут переподключения (сек)

# --- MAILING SETTINGS ---
MAILING_BATCH_SIZE=10  # Размер пачки отправленных сообщений
MAILING_CHECK_INTERVAL=10  # Проверка прогресса каждые N отправок
MAILING_MIN_DELAY=45  # Минимальная задержка между сообщениями (сек)
MAILING_MAX_DELAY=80  # Максимальная задержка между сообщениями (сек)
MAILING_FLOOD_WAIT_PADDING=5  # Дополнительная пауза после FloodWait (сек)
MAILING_CONSECUTIVE_ERROR_LONG_DELAY=30  # Длительная пауза при многих ошибках (сек)
MAILING_CONSECUTIVE_ERROR_SHORT_DELAY=2  # Короткая пауза при единичных ошибках (сек)

# --- RETRY/BACKOFF ---
RETRY_BACKOFF_BASE=2.0  # Основа экспоненциальной задержки
RETRY_DEFAULT_DELAY=1.0  # Базовая задержка retry_async (сек)
JSON_STORAGE_RETRY_DELAY=0.5  # Базовая задержка записи JSONStorage (сек)
FLOOD_WAIT_PADDING=5  # Дополнительная пауза после FloodWait в инвайте (сек)

# --- ERROR BACKOFF (randomized min/max) ---
HEALTH_CHECK_ERROR_DELAY_MIN=15
HEALTH_CHECK_ERROR_DELAY_MAX=45
WORKER_SCALE_ERROR_DELAY_MIN=15
WORKER_SCALE_ERROR_DELAY_MAX=45
TASK_HEALTH_CHECK_ERROR_DELAY_MIN=15
TASK_HEALTH_CHECK_ERROR_DELAY_MAX=45
WORKER_ERROR_DELAY_MIN=1
WORKER_ERROR_DELAY_MAX=2
WORM_MSG_ERROR_DELAY_MIN=1
WORM_MSG_ERROR_DELAY_MAX=2
WORM_SCAN_ERROR_DELAY_MIN=5
WORM_SCAN_ERROR_DELAY_MAX=10
WORM_TOP_ERROR_DELAY_MIN=10
WORM_TOP_ERROR_DELAY_MAX=20
CACHE_CLEANUP_ERROR_DELAY_MIN=180
CACHE_CLEANUP_ERROR_DELAY_MAX=420
ACTIVITY_ERROR_DELAY_MIN=300
ACTIVITY_ERROR_DELAY_MAX=900
OLD_TASK_CLEANUP_ERROR_DELAY_MIN=1800
OLD_TASK_CLEANUP_ERROR_DELAY_MAX=5400

# --- INTERVALS ---
TASK_HEALTH_CHECK_INTERVAL=60  # Интервал проверки здоровья задач (сек)
ENTITY_CACHE_CLEANUP_INTERVAL=1800  # Очистка кэша сущностей (сек)
ACTIVITY_SIMULATION_INTERVAL=3600  # Частота эмуляции активности (сек)
OLD_TASK_CLEANUP_INTERVAL=86400  # Очистка старых задач (сек)

# --- INVITE BEHAVIOR ---
INVITE_RETRY_DELAY_MIN=1  # Минимальная задержка при ретрае инвайта (сек)
INVITE_RETRY_DELAY_MAX=3  # Максимальная задержка при ретрае инвайта (сек)
INVITE_JITTER_MIN=0.8  # Минимальный множитель джиттера для задержки
INVITE_JITTER_MAX=1.2  # Максимальный множитель джиттера для задержки
HUMAN_SKIP_DELAY_MIN=10  # Минимальная задержка при симуляции пропуска (сек)
HUMAN_SKIP_DELAY_MAX=30  # Максимальная задержка при симуляции пропуска (сек)
POST_BUFFER_DELAY_MIN=30  # Минимальная задержка после буфера инвайтов (сек)
POST_BUFFER_DELAY_MAX=60  # Максимальная задержка после буфера инвайтов (сек)
CHAT_ADD_THROTTLE_DELAY_MIN=1.0  # Минимальная задержка при добавлении чатов (сек)
CHAT_ADD_THROTTLE_DELAY_MAX=2.0  # Максимальная задержка при добавлении чатов (сек)

# --- VALIDATOR ---
VALIDATOR_ANTI_FLOOD_DELAY_MIN=3  # Минимальная анти-флуд задержка (сек)
VALIDATOR_ANTI_FLOOD_DELAY_MAX=7  # Максимальная анти-флуд задержка (сек)

# --- SIMULATION ---
SIMULATE_ACTIVITY_POST_DELAY_MIN=60  # Минимальная задержка после эмуляции (сек)
SIMULATE_ACTIVITY_POST_DELAY_MAX=180  # Максимальная задержка после эмуляции (сек)

# --- PATHS ---
SESSIONS_DIR=sessions
DATA_DIR=data
AUTH_FILE=data/auth.json
TASKS_FILE=data/tasks.json
CACHE_DB_PATH=data/cache.db
CHATS_DB_PATH=data/chats.db

# --- FEATURES ---
AUTO_LEAVE_AFTER_INVITE=true