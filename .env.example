# --- TELEGRAM BOT ---
BOT_TOKEN=...
API_ID=...
API_HASH=...
ADMIN_USER_IDS=...

# --- RATE LIMITING ---
RATE_LIMIT_COOLDOWN=0.2

# --- Task settings ---
MAX_CONCURRENT_TASKS=10
MAX_TASKS_PER_USER=5
MIN_WORKERS=2
MAX_WORKERS=10
WORKER_CHECK_INTERVAL=10
WORKER_IDLE_TIMEOUT=300

# --- ANTI-BLOCK SETTINGS ---
MIN_INVITE_DELAY=40
MAX_INVITE_DELAY=70
FLOOD_WAIT_MULTIPLIER=1.5
MAX_RETRIES=3
HEALTH_CHECK_INTERVAL=300
MAX_ACCOUNTS_PER_TASK=3
SESSION_TIMEOUT=1800

# --- HUMAN-LIKE BEHAVIOR ---
HUMAN_BREAK_CHANCE=0.2  # 20% шанс "перерыва на кофе"
HUMAN_BREAK_MIN=300  # Минимальный перерыв (сек)
HUMAN_BREAK_MAX=900  # Максимальный перерыв (сек)
SIMULATE_SKIP_RATE=0.05  # 5% шанс "ошибки" при инвите
ACTIVITY_SIMULATION_INTERVAL=3600  # Частота эмуляции активности (сек)

# --- WORM SETTINGS ---
WORM_BATCH_SIZE=50  # Размер пачки сообщений для обработки
WORM_CHECK_INTERVAL=10  # Проверка статуса каждые N сообщений
WORM_MIN_DELAY=3  # Минимальная задержка между чатами (сек)
WORM_MAX_DELAY=7  # Максимальная задержка между чатами (сек)
WORM_MESSAGE_LIMIT=0  # 0 = бесконечно, >0 = лимит сообщений
WORM_MAX_CONCURRENT=5  # Максимум одновременных червей
WORM_SCAN_LIMIT=1000  # Лимит сообщений на чат при сканировании

# --- VALIDATOR SETTINGS ---
VALIDATOR_TEST_DELETE_WAIT=5  # Время ожидания удаления тестового сообщения (сек)
VALIDATOR_RECONNECT_TIMEOUT=30  # Таймаут переподключения (сек)

# --- MAILING SETTINGS ---
MAILING_BATCH_SIZE=10  # Размер пачки отправленных сообщений
MAILING_CHECK_INTERVAL=10  # Проверка прогресса каждые N отправок
MAILING_MIN_DELAY=45  # Минимальная задержка между сообщениями (сек)
MAILING_MAX_DELAY=80  # Максимальная задержка между сообщениями (сек)

# --- PATHS ---
SESSIONS_DIR=sessions
DATA_DIR=data
AUTH_FILE=data/auth.json
TASKS_FILE=data/tasks.json
CACHE_DB_PATH=data/cache.db
CHATS_DB_PATH=data/chats.db

# --- FEATURES ---
AUTO_LEAVE_AFTER_INVITE=true